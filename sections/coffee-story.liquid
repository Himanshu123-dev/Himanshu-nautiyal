{% comment %} {{ 'coffee-story.css' | asset_url | stylesheet_tag }} {% endcomment %}

<section class="coffee-story" id="coffee-story-{{ section.id }}">
  <p class="coffee-story__eyebrow">{{ section.settings.eyebrow }}</p>

  <div class="coffee-story__inner">
    <div class="coffee-story__panel">
      <h2 class="coffee-story__heading">{{ section.settings.heading }}</h2>
      <div class="coffee-story__text">{{ section.settings.body_text }}</div>

      {%- if section.settings.illustration != blank -%}
        <img
          class="coffee-story__illustration"
          src="{{ section.settings.illustration | image_url: width: 700 }}"
          alt="{{ section.settings.illustration.alt | escape }}"
          width="{{ section.settings.illustration.width }}"
          height="{{ section.settings.illustration.height }}"
          loading="lazy"
        >
      {%- endif -%}
    </div>

    <div class="coffee-story__media">
      {%- if section.settings.image != blank -%}
        <img
          srcset="{{ section.settings.image | image_url: width: 600 }} 600w,
                  {{ section.settings.image | image_url: width: 900 }} 900w,
                  {{ section.settings.image | image_url: width: 1200 }} 1200w"
          sizes="(min-width: 990px) 50vw, 100vw"
          src="{{ section.settings.image | image_url: width: 900 }}"
          alt="{{ section.settings.image.alt | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="lazy"
        >
      {%- else -%}
        <div class="coffee-story__media-placeholder">{{ 'lifestyle-1' | placeholder_svg_tag: 'coffee-story__placeholder-svg' }}</div>
      {%- endif -%}

      {%- if section.settings.video_url != blank -%}
        <button
          type="button"
          class="coffee-story__play"
          aria-label="{{ 'sections.video.play_video' | t | default: 'Play video' }}"
          data-video-url="{{ section.settings.video_url }}"
        >
          <svg width="18" height="20" viewBox="0 0 18 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M17 8.27a2 2 0 0 1 0 3.46L2.98 19.63A2 2 0 0 1 0 17.9V2.1A2 2 0 0 1 2.98.37L17 8.27Z" fill="currentColor"/>
          </svg>
        </button>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.video_url != blank -%}
    <div class="coffee-story__modal" hidden data-coffee-story-modal>
      <div class="coffee-story__modal-backdrop" data-coffee-story-close></div>
      <div class="coffee-story__modal-content">
        <button type="button" class="coffee-story__modal-close" data-coffee-story-close aria-label="Close video">&times;</button>
        <div class="coffee-story__modal-frame" data-coffee-story-frame></div>
      </div>
    </div>
  {%- endif -%}
</section>

<script>
  (function () {
    var root = document.getElementById('coffee-story-{{ section.id }}');
    if (!root) return;
    var playBtn = root.querySelector('.coffee-story__play');
    var modal = root.querySelector('[data-coffee-story-modal]');
    if (!playBtn || !modal) return;
    var frame = modal.querySelector('[data-coffee-story-frame]');
    var closers = modal.querySelectorAll('[data-coffee-story-close]');

    playBtn.addEventListener('click', function () {
      var url = playBtn.getAttribute('data-video-url');
      frame.innerHTML = '<iframe src="' + url + '" allow="autoplay; fullscreen" allowfullscreen frameborder="0"></iframe>';
      modal.hidden = false;
    });

    closers.forEach(function (el) {
      el.addEventListener('click', function () {
        modal.hidden = true;
        frame.innerHTML = '';
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Coffee story",
  "tag": "section",
  "class": "section-coffee-story",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "Try our recipe" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "100% Arabica coffee. Directly sourced from farms. Freshly roasted." },
    { "type": "richtext", "id": "body_text", "label": "Body text", "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec erat urna, tincidunt neque gravida.</p>" },
    { "type": "image_picker", "id": "illustration", "label": "Illustration (optional)" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "video_url", "label": "Video embed URL", "info": "e.g. a YouTube or Vimeo embed link. Leave blank to hide the play button." }
  ],
  "presets": [
    { "name": "Coffee story" }
  ]
}
{% endschema %}
