{{ 'gift-guide-banner.css' | asset_url | stylesheet_tag }}

<section
  class="gift-banner"
  id="gift-banner-{{ section.id }}"
  style="
    --topbar-bg: {{ section.settings.topbar_bg_color }};
    --bottombar-bg: {{ section.settings.bottombar_bg_color }};
    --bottombar-color: {{ section.settings.bottombar_text_color }};
    --heading-color: {{ section.settings.text_color }};
    --top-btn-bg: {{ section.settings.top_button_bg_color }};
    --top-btn-color: {{ section.settings.top_button_text_color }};
    --btn-bg: {{ section.settings.button_bg_color }};
    --btn-color: {{ section.settings.button_text_color }};
  "
>
  <div class="gift-banner__topbar">
    <button
      type="button"
      class="gift-banner__menu-toggle"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="gift-banner-panel-{{ section.id }}"
    >
      <span class="gift-banner__menu-icon" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>

    {% if section.settings.logo_image != blank %}
      <div class="gift-banner__logo">{{ section.settings.logo_image }}</div>
    {% endif %}

    {% if section.settings.announcement_text != blank %}
      <div class="gift-banner__announcement">{{ section.settings.announcement_text }}</div>
    {% endif %}

    {% if section.settings.top_button_text != blank %}
      <a
        href="{{ section.settings.top_button_link | default: '#' }}"
        class="gift-banner__btn gift-banner__btn--top"
      >
        <span>{{ section.settings.top_button_text }}</span>
        <span class="gift-banner__arrow" aria-hidden="true">&rarr;</span>
      </a>
    {% endif %}
  </div>

  <div class="gift-banner__mobile-panel" id="gift-banner-panel-{{ section.id }}">
    {% if section.settings.announcement_text != blank %}
      <p class="gift-banner__mobile-announcement">{{ section.settings.announcement_text }}</p>
    {% endif %}

    {% if section.settings.top_button_text != blank %}
      <a
        href="{{ section.settings.top_button_link | default: '#' }}"
        class="gift-banner__btn gift-banner__btn--top gift-banner__mobile-btn"
      >
        <span>{{ section.settings.top_button_text }}</span>
        <span class="gift-banner__arrow" aria-hidden="true">&rarr;</span>
      </a>
    {% endif %}
  </div>

  <div class="gift-banner__hero">
    <div class="gift-banner__media">
      {% if section.settings.mobile_background_image %}
        {% if section.settings.background_image %}
          <img
            class="gift-banner__bg gift-banner__bg--desktop-only"
            src="{{ section.settings.background_image | image_url: width: 1600 }}"
            srcset="
              {{ section.settings.background_image | image_url: width: 800 }} 800w,
              {{ section.settings.background_image | image_url: width: 1200 }} 1200w,
              {{ section.settings.background_image | image_url: width: 1600 }} 1600w,
              {{ section.settings.background_image | image_url: width: 2000 }} 2000w
            "
            sizes="100vw"
            alt=""
            loading="lazy"
            width="{{ section.settings.background_image.width }}"
            height="{{ section.settings.background_image.height }}"
          >
        {% endif %}
        <img
          class="gift-banner__bg gift-banner__bg--mobile-only"
          src="{{ section.settings.mobile_background_image | image_url: width: 800 }}"
          srcset="
            {{ section.settings.mobile_background_image | image_url: width: 480 }} 480w,
            {{ section.settings.mobile_background_image | image_url: width: 800 }} 800w,
            {{ section.settings.mobile_background_image | image_url: width: 1200 }} 1200w
          "
          sizes="100vw"
          alt=""
          loading="lazy"
          width="{{ section.settings.mobile_background_image.width }}"
          height="{{ section.settings.mobile_background_image.height }}"
        >
      {% elsif section.settings.background_image %}
        <img
          class="gift-banner__bg"
          src="{{ section.settings.background_image | image_url: width: 1600 }}"
          srcset="
            {{ section.settings.background_image | image_url: width: 800 }} 800w,
            {{ section.settings.background_image | image_url: width: 1200 }} 1200w,
            {{ section.settings.background_image | image_url: width: 1600 }} 1600w,
            {{ section.settings.background_image | image_url: width: 2000 }} 2000w
          "
          sizes="100vw"
          alt=""
          loading="lazy"
          width="{{ section.settings.background_image.width }}"
          height="{{ section.settings.background_image.height }}"
        >
      {% endif %}

      {% if section.settings.button_text != blank %}
        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="gift-banner__btn gift-banner__btn--main gift-banner__media-btn"
        >
          <span>{{ section.settings.button_text }}</span>
          <span class="gift-banner__arrow" aria-hidden="true">&rarr;</span>
        </a>
      {% endif %}
    </div>

    <div class="gift-banner__content">
      {% if section.settings.heading != blank %}
        <h2 class="gift-banner__heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="gift-banner__description">{{ section.settings.description }}</p>
      {% endif %}

      {% if section.settings.button_text != blank %}
        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="gift-banner__btn gift-banner__btn--main"
        >
          <span>{{ section.settings.button_text }}</span>
          <span class="gift-banner__arrow" aria-hidden="true">&rarr;</span>
        </a>
      {% endif %}
    </div>
  </div>

  {% if section.settings.bottom_text != blank %}
    <div class="gift-banner__bottombar">
      <p>{{ section.settings.bottom_text }}</p>
    </div>
  {% endif %}
</section>

<script>
  (function () {
    var sectionId = {{ section.id | json }};

    function init() {
      var root = document.getElementById('gift-banner-' + sectionId);
      if (!root || root.dataset.menuInitialized === 'true') return;
      root.dataset.menuInitialized = 'true';

      var toggleBtn = root.querySelector('.gift-banner__menu-toggle');
      var panel = document.getElementById('gift-banner-panel-' + sectionId);
      if (!toggleBtn || !panel) return;

      toggleBtn.addEventListener('click', function () {
        var isOpen = toggleBtn.getAttribute('aria-expanded') === 'true';
        toggleBtn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
        panel.classList.toggle('is-open', !isOpen);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail && event.detail.sectionId === sectionId) {
        var root = document.getElementById('gift-banner-' + sectionId);
        if (root) root.dataset.menuInitialized = 'false';
        init();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Gift guide banner",
  "settings": [
    {
      "type": "header",
      "content": "Top bar"
    },
    {
      "type": "text",
      "id": "logo_image",
      "label": "Logo",
      "default":"TISSO VISON"
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "top_button_text",
      "label": "Top button label",
      "default": "Choose gift"
    },
    {
      "type": "url",
      "id": "top_button_link",
      "label": "Top button link"
    },
    {
      "type": "color",
      "id": "topbar_bg_color",
      "label": "Top bar background",
      "default": "#F4F3F1"
    },
    {
      "type": "color",
      "id": "top_button_bg_color",
      "label": "Top button background",
      "default": "#F6E100"
    },
    {
      "type": "color",
      "id": "top_button_text_color",
      "label": "Top button text",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Hero image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Banner image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "mobile_background_image",
      "label": "Banner image (mobile)",
      "info": "Optional. If left empty, the desktop image is used on mobile too."
    },
    {
      "type": "header",
      "content": "Hero content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading & text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "bottom_text",
      "label": "Bottom bar text",
      "default": "Sustainable, ethically made clothes in sizes XXS to 6XL"
    },
    {
      "type": "color",
      "id": "bottombar_bg_color",
      "label": "Bottom bar background",
      "default": "#F4F3F1"
    },
    {
      "type": "color",
      "id": "bottombar_text_color",
      "label": "Bottom bar text",
      "default": "#111111"
    }
  ],
  "presets": [
    {
      "name": "Gift guide banner"
    }
  ]
}
{% endschema %}
