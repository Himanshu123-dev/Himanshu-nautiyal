{{ 'shoppable-image-grid.css' | asset_url | stylesheet_tag }}

<section class="shoppable-grid-section" id="shoppable-grid-{{ section.id }}">
  {% if section.settings.heading != blank %}
    <h2 class="shoppable-grid__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="shoppable-grid">
    {% for block in section.blocks %}
      {% assign product = block.settings.product %}
      {% if product %}
        {% assign block_image = block.settings.custom_image | default: product.featured_image %}
        <div class="shoppable-grid__item" {{ block.shopify_attributes }}>
          {% capture grid_img_src %}{% if block_image %}{{ block_image | image_url: width: 800 }}{% endif %}{% endcapture %}
          {% unless grid_img_src contains 'Liquid error' or grid_img_src == blank %}
            <img
              class="shoppable-grid__image"
              src="{{ block_image | image_url: width: 800 }}"
              srcset="{{ block_image | image_url: width: 400 }} 400w, {{ block_image | image_url: width: 800 }} 800w, {{ block_image | image_url: width: 1200 }} 1200w"
              sizes="(min-width: 750px) 33vw, 50vw"
              alt="{{ block_image.alt | default: product.title | escape }}"
              loading="lazy"
              width="{{ block_image.width }}"
              height="{{ block_image.height }}"
            >
          {% endunless %}
          <button
            type="button"
            class="shoppable-grid__hotspot"
            style="left: {{ block.settings.position_x }}%; top: {{ block.settings.position_y }}%;"
            data-product-handle="{{ product.handle }}"
            aria-label="Quick view {{ product.title | escape }}"
          >
            <span aria-hidden="true">+</span>
          </button>

          <script type="application/json" id="product-json-{{ product.handle }}-{{ section.id }}">
            {
              "id": {{ product.id | json }},
              "title": {{ product.title | json }},
              "handle": {{ product.handle | json }},
              "price": {{ product.price | json }},
              "compareAtPrice": {{ product.compare_at_price | json }},
              "description": {{ product.description | strip_html | truncatewords: 40 | json }},
              {% capture product_image_json %}{% if product.featured_image %}{{ product.featured_image | image_url: width: 600 | json }}{% endif %}{% endcapture %}
              "image": {% if product_image_json contains 'Liquid error' or product_image_json == blank %}null{% else %}{{ product_image_json }}{% endif %},
              "options": {{ product.options_with_values | json }},
              "variants": [
                {% for variant in product.variants %}
                {
                  "id": {{ variant.id | json }},
                  "title": {{ variant.title | json }},
                  "price": {{ variant.price | json }},
                  "available": {{ variant.available | json }},
                  {% capture variant_image_json %}{% if variant.featured_image %}{{ variant.featured_image | image_url: width: 600 | json }}{% endif %}{% endcapture %}
                  "image": {% if variant_image_json contains 'Liquid error' or variant_image_json == blank %}null{% else %}{{ variant_image_json }}{% endif %},
                  "option1": {{ variant.option1 | json }},
                  "option2": {{ variant.option2 | json }},
                  "option3": {{ variant.option3 | json }}
                }{% unless forloop.last %},{% endunless %}
                {% endfor %}
              ]
            }
          </script>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  {% comment %} Data describing the product that must be auto-added when the trigger combo is selected {% endcomment %}
  {% assign auto_add_product = section.settings.auto_add_product %}
  <script type="application/json" id="auto-add-json-{{ section.id }}">
    {
      "id": {{ auto_add_product.id | json }},
      "title": {{ auto_add_product.title | json }},
      "variantId": {{ auto_add_product.selected_or_first_available_variant.id | json }},
      "triggerColor": {{ section.settings.trigger_color | json }},
      "triggerSize": {{ section.settings.trigger_size | json }}
    }
  </script>

  <div class="product-popup-overlay" id="product-popup-overlay-{{ section.id }}" hidden>
    <div class="product-popup" role="dialog" aria-modal="true" aria-labelledby="product-popup-title-{{ section.id }}">
      <button type="button" class="product-popup__close" aria-label="Close">&times;</button>
      <div class="product-popup__content">
        <div class="product-popup__header">
          <div class="product-popup__media">
            <img class="product-popup__image" src="" alt="">
          </div>
          <div class="product-popup__header-text">
            <h3 class="product-popup__title" id="product-popup-title-{{ section.id }}"></h3>
            <p class="product-popup__price"></p>
            <p class="product-popup__description"></p>
          </div>
        </div>

        <div class="product-popup__option product-popup__option--color" hidden>
          <label class="product-popup__option-label"></label>
          <div class="product-popup__swatches"></div>
        </div>

        <div class="product-popup__option product-popup__option--size" hidden>
          <label class="product-popup__option-label"></label>
          <select class="product-popup__size-select"></select>
        </div>

        <button type="button" class="product-popup__add-to-cart">
          <span class="product-popup__add-to-cart-text">ADD TO CART</span>
          <span aria-hidden="true">&rarr;</span>
        </button>
        <p class="product-popup__message" aria-live="polite"></p>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var sectionId = {{ section.id | json }};
    var shopCurrency = {{ shop.currency | json }};

    function formatMoney(cents) {
      if (typeof cents !== 'number') return '';
      try {
        return new Intl.NumberFormat(undefined, { style: 'currency', currency: shopCurrency }).format(cents / 100);
      } catch (e) {
        return (cents / 100).toFixed(2) + ' ' + shopCurrency;
      }
    }

    function init() {
      var root = document.getElementById('shoppable-grid-' + sectionId);
      if (!root || root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';

      var overlay = document.getElementById('product-popup-overlay-' + sectionId);
      var popup = overlay.querySelector('.product-popup');
      var closeBtn = overlay.querySelector('.product-popup__close');
      var imageEl = overlay.querySelector('.product-popup__image');
      var titleEl = overlay.querySelector('.product-popup__title');
      var priceEl = overlay.querySelector('.product-popup__price');
      var descEl = overlay.querySelector('.product-popup__description');
      var colorWrap = overlay.querySelector('.product-popup__option--color');
      var colorLabel = colorWrap.querySelector('.product-popup__option-label');
      var swatchesEl = overlay.querySelector('.product-popup__swatches');
      var sizeWrap = overlay.querySelector('.product-popup__option--size');
      var sizeLabel = sizeWrap.querySelector('.product-popup__option-label');
      var sizeSelect = overlay.querySelector('.product-popup__size-select');
      var addToCartBtn = overlay.querySelector('.product-popup__add-to-cart');
      var messageEl = overlay.querySelector('.product-popup__message');

      var autoAddData = null;
      try {
        var autoAddDataEl = document.getElementById('auto-add-json-' + sectionId);
        if (autoAddDataEl) autoAddData = JSON.parse(autoAddDataEl.textContent);
      } catch (err) {
        console.error('Shoppable grid: could not parse auto-add product data.', err);
      }

      var currentProduct = null;
      var selectedOptions = {};
      var optionDefaults = {};

      function getProductData(handle) {
        var el = document.getElementById('product-json-' + handle + '-' + sectionId);
        if (!el) return null;
        try {
          return JSON.parse(el.textContent);
        } catch (err) {
          console.error('Shoppable grid: could not parse product data for "' + handle + '".', err);
          return null;
        }
      }

      // Bind hotspot click listeners FIRST so the popup always opens even if
      // something else below (e.g. auto-add data) fails to parse.
      var lastAnchorEl = null;

      root.querySelectorAll('.shoppable-grid__hotspot').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var item = btn.closest('.shoppable-grid__item') || btn;
          openPopup(btn.dataset.productHandle, item);
        });
      });

      function findMatchingVariant() {
        if (!currentProduct) return null;
        return currentProduct.variants.filter(function (variant) {
          return currentProduct.options.every(function (opt, index) {
            var key = 'option' + (index + 1);
            var value = selectedOptions[opt.name];
            if (value === undefined || value === '') value = optionDefaults[opt.name];
            return value === undefined || variant[key] === value;
          });
        })[0] || null;
      }

      function updatePriceAndImage() {
        var variant = findMatchingVariant();
        var price = variant ? variant.price : currentProduct.price;
        priceEl.textContent = formatMoney(price);
        var img = (variant && variant.image) || currentProduct.image;
        if (img) imageEl.src = img;

        if (variant && !variant.available) {
          addToCartBtn.disabled = true;
          messageEl.textContent = 'This combination is currently unavailable.';
        } else {
          addToCartBtn.disabled = false;
          messageEl.textContent = '';
        }
      }

      function renderSwatches(option, index) {
        colorWrap.hidden = false;
        colorLabel.textContent = option.name;
        swatchesEl.innerHTML = '';
        option.values.forEach(function (value) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'product-popup__swatch';
          btn.textContent = value;
          btn.dataset.value = value;
          if (selectedOptions[option.name] === value) btn.classList.add('is-selected');
          btn.addEventListener('click', function () {
            selectedOptions[option.name] = value;
            swatchesEl.querySelectorAll('.product-popup__swatch').forEach(function (b) {
              b.classList.toggle('is-selected', b === btn);
            });
            updatePriceAndImage();
          });
          swatchesEl.appendChild(btn);
        });
      }

      function renderSizeSelect(option, index) {
        sizeWrap.hidden = false;
        sizeLabel.textContent = option.name;
        sizeSelect.innerHTML = '';

        var placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.textContent = 'Choose your ' + option.name.toLowerCase();
        placeholder.disabled = true;
        placeholder.selected = true;
        sizeSelect.appendChild(placeholder);

        option.values.forEach(function (value) {
          var opt = document.createElement('option');
          opt.value = value;
          opt.textContent = value;
          sizeSelect.appendChild(opt);
        });
        sizeSelect.onchange = function () {
          selectedOptions[option.name] = sizeSelect.value;
          updatePriceAndImage();
        };
      }

      function positionPopup(anchorEl) {
        if (!anchorEl) return;
        var margin = 12;
        var gap = 14;
        var anchorRect = anchorEl.getBoundingClientRect();
        var popupRect = popup.getBoundingClientRect();
        var viewportWidth = window.innerWidth;
        var viewportHeight = window.innerHeight;
        var popupWidth = popupRect.width;
        var popupHeight = popupRect.height;

        var left = anchorRect.left + anchorRect.width / 2 - popupWidth / 2;
        left = Math.max(margin, Math.min(left, viewportWidth - popupWidth - margin));

        var placeAbove = true;
        var top = anchorRect.top - popupHeight - gap;
        if (top < margin) {
          placeAbove = false;
          top = anchorRect.bottom + gap;
          if (top + popupHeight > viewportHeight - margin) {
            top = Math.max(margin, viewportHeight - margin - popupHeight);
          }
        }

        popup.style.left = left + 'px';
        popup.style.top = top + 'px';

        popup.classList.toggle('product-popup--arrow-down', placeAbove);
        popup.classList.toggle('product-popup--arrow-up', !placeAbove);

        var arrowLeft = anchorRect.left + anchorRect.width / 2 - left;
        arrowLeft = Math.max(18, Math.min(arrowLeft, popupWidth - 18));
        popup.style.setProperty('--arrow-left', arrowLeft + 'px');
      }

      function openPopup(handle, anchorEl) {
        var data = getProductData(handle);
        if (!data) return;
        currentProduct = data;
        selectedOptions = {};
        optionDefaults = {};
        lastAnchorEl = anchorEl || lastAnchorEl;

        titleEl.textContent = data.title;
        descEl.textContent = data.description;
        imageEl.src = data.image || '';
        imageEl.alt = data.title;

        colorWrap.hidden = true;
        sizeWrap.hidden = true;
        swatchesEl.innerHTML = '';
        sizeSelect.innerHTML = '';

        data.options.forEach(function (option, index) {
          var name = (option.name || '').toLowerCase();
          optionDefaults[option.name] = option.values[0];
          if (name.indexOf('color') !== -1 || name.indexOf('colour') !== -1) {
            selectedOptions[option.name] = option.values[0];
            renderSwatches(option, index);
          } else {
            renderSizeSelect(option, index);
          }
        });

        updatePriceAndImage();

        popup.style.visibility = 'hidden';
        overlay.hidden = false;
        document.body.style.overflow = 'hidden';
        positionPopup(lastAnchorEl);
        popup.style.visibility = 'visible';
        closeBtn.focus();
      }

      function closePopup() {
        overlay.hidden = true;
        document.body.style.overflow = '';
        currentProduct = null;
        lastAnchorEl = null;
      }

      window.addEventListener('resize', function () {
        if (!overlay.hidden && lastAnchorEl) positionPopup(lastAnchorEl);
      });

      function addToCart(items) {
        return fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ items: items })
        }).then(function (res) {
          if (!res.ok) return res.json().then(function (err) { throw err; });
          return res.json();
        });
      }

      function getEffectiveOptionValues() {
        if (!currentProduct) return [];
        return currentProduct.options.map(function (opt) {
          var value = selectedOptions[opt.name];
          if (value === undefined || value === '') value = optionDefaults[opt.name];
          return value;
        });
      }

      function shouldAutoAdd() {
        if (!autoAddData || !autoAddData.variantId) return false;
        var values = getEffectiveOptionValues();
        return (
          values.indexOf(autoAddData.triggerColor) !== -1 &&
          values.indexOf(autoAddData.triggerSize) !== -1
        );
      }

      addToCartBtn.addEventListener('click', function () {
        var variant = findMatchingVariant();
        if (!variant || !variant.available) {
          messageEl.textContent = 'This combination is currently unavailable.';
          return;
        }

        var items = [{ id: variant.id, quantity: 1 }];
        var autoAdded = false;
        if (shouldAutoAdd() && autoAddData.variantId !== variant.id) {
          items.push({ id: autoAddData.variantId, quantity: 1 });
          autoAdded = true;
        }

        addToCartBtn.disabled = true;
        messageEl.textContent = 'Adding...';

        addToCart(items)
          .then(function () {
            messageEl.textContent = autoAdded
              ? 'Added to cart, plus ' + autoAddData.title + '!'
              : 'Added to cart!';
            document.dispatchEvent(new CustomEvent('cart:updated'));
          })
          .catch(function () {
            messageEl.textContent = 'Could not add this item to your cart.';
          })
          .finally(function () {
            addToCartBtn.disabled = false;
          });
      });

      closeBtn.addEventListener('click', closePopup);
      overlay.addEventListener('click', function (e) {
        if (e.target === overlay) closePopup();
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !overlay.hidden) closePopup();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail && event.detail.sectionId === sectionId) {
        var root = document.getElementById('shoppable-grid-' + sectionId);
        if (root) root.dataset.initialized = 'false';
        init();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Shoppable image grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    },
    {
      "type": "product",
      "id": "auto_add_product",
      "label": "Auto-add product",
      "info": "This product is added to the cart automatically when a shopper adds a product with the trigger color and size below."
    },
    {
      "type": "text",
      "id": "trigger_color",
      "label": "Trigger color value",
      "default": "Black"
    },
    {
      "type": "text",
      "id": "trigger_size",
      "label": "Trigger size value",
      "default": "Medium"
    }
  ],
  "blocks": [
    {
      "type": "product_1",
      "name": "Product 1",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "custom_image", "label": "Custom image (optional)", "info": "Defaults to the product's featured image if left empty." },
        { "type": "range", "id": "position_x", "label": "Hotspot horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 68 },
        { "type": "range", "id": "position_y", "label": "Hotspot vertical position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 48 }
      ]
    },
    {
      "type": "product_2",
      "name": "Product 2",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "custom_image", "label": "Custom image (optional)", "info": "Defaults to the product's featured image if left empty." },
        { "type": "range", "id": "position_x", "label": "Hotspot horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 78 },
        { "type": "range", "id": "position_y", "label": "Hotspot vertical position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 45 }
      ]
    },
    {
      "type": "product_3",
      "name": "Product 3",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "custom_image", "label": "Custom image (optional)", "info": "Defaults to the product's featured image if left empty." },
        { "type": "range", "id": "position_x", "label": "Hotspot horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 60 },
        { "type": "range", "id": "position_y", "label": "Hotspot vertical position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 18 }
      ]
    },
    {
      "type": "product_4",
      "name": "Product 4",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "custom_image", "label": "Custom image (optional)", "info": "Defaults to the product's featured image if left empty." },
        { "type": "range", "id": "position_x", "label": "Hotspot horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 58 },
        { "type": "range", "id": "position_y", "label": "Hotspot vertical position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 25 }
      ]
    },
    {
      "type": "product_5",
      "name": "Product 5",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "custom_image", "label": "Custom image (optional)", "info": "Defaults to the product's featured image if left empty." },
        { "type": "range", "id": "position_x", "label": "Hotspot horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 40 },
        { "type": "range", "id": "position_y", "label": "Hotspot vertical position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 45 }
      ]
    },
    {
      "type": "product_6",
      "name": "Product 6",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "custom_image", "label": "Custom image (optional)", "info": "Defaults to the product's featured image if left empty." },
        { "type": "range", "id": "position_x", "label": "Hotspot horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 68 },
        { "type": "range", "id": "position_y", "label": "Hotspot vertical position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 28 }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Shoppable image grid",
      "blocks": [
        { "type": "product_1" },
        { "type": "product_2" },
        { "type": "product_3" },
        { "type": "product_4" },
        { "type": "product_5" },
        { "type": "product_6" }
      ]
    }
  ]
}
{% endschema %}
