{{ 'shoppable-image-grid.css' | asset_url | stylesheet_tag }}

<section class="shoppable-grid-section" id="shoppable-grid-{{ section.id }}">
  {% if section.settings.heading != blank %}
    <h2 class="shoppable-grid__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="shoppable-grid">
    {% for block in section.blocks %}
      {% assign product = block.settings.product %}
      {% if product %}
        {% assign block_image = block.settings.custom_image | default: product.featured_image %}
        {% assign popup_id = 'product-popup-' | append: product.id | append: '-' | append: section.id %}

        <div class="shoppable-grid__item" {{ block.shopify_attributes }}>
          <div class="shoppable-grid__image-wrap">
            {% capture grid_img_src %}{% if block_image %}{{ block_image | image_url: width: 800 }}{% endif %}{% endcapture %}
            {% unless grid_img_src contains 'Liquid error' or grid_img_src == blank %}
              <img
                class="shoppable-grid__image"
                src="{{ block_image | image_url: width: 800 }}"
                srcset="{{ block_image | image_url: width: 400 }} 400w, {{ block_image | image_url: width: 800 }} 800w, {{ block_image | image_url: width: 1200 }} 1200w"
                sizes="(min-width: 750px) 33vw, 50vw"
                alt="{{ block_image.alt | default: product.title | escape }}"
                loading="lazy"
                width="{{ block_image.width }}"
                height="{{ block_image.height }}"
              >
            {% endunless %}
            <button
              type="button"
              class="shoppable-grid__hotspot"
              style="left: {{ block.settings.position_x }}%; top: {{ block.settings.position_y }}%;"
              data-popup-target="{{ popup_id }}"
              aria-label="Quick view {{ product.title | escape }}"
              aria-expanded="false"
              aria-controls="{{ popup_id }}"
            >
              <span aria-hidden="true">+</span>
            </button>
          </div>

          <div class="product-popup" id="{{ popup_id }}" role="dialog" aria-modal="true" aria-labelledby="{{ popup_id }}-title" hidden>
            <button type="button" class="product-popup__close" aria-label="Close">&times;</button>
            <div class="product-popup__content">
              <div class="product-popup__header">
                <div class="product-popup__media">
                  {% capture popup_img_src %}{% if product.featured_image %}{{ product.featured_image | image_url: width: 400 }}{% endif %}{% endcapture %}
                  {% unless popup_img_src contains 'Liquid error' or popup_img_src == blank %}
                    <img class="product-popup__image" src="{{ popup_img_src }}" alt="{{ product.title | escape }}">
                  {% endunless %}
                </div>
                <div class="product-popup__header-text">
                  <h3 class="product-popup__title" id="{{ popup_id }}-title">{{ product.title }}</h3>
                  <p class="product-popup__price" data-base-price="{{ product.price }}">{{ product.price | money }}</p>
                  <p class="product-popup__description">{{ product.description | strip_html | truncatewords: 40 }}</p>
                </div>
              </div>

              {% for option in product.options_with_values %}
                {% assign option_name_lower = option.name | downcase %}
                {% if option_name_lower contains 'color' or option_name_lower contains 'colour' %}
                  <div class="product-popup__option product-popup__option--color" data-option-index="{{ forloop.index }}" data-option-name="{{ option.name | escape }}">
                    <label class="product-popup__option-label">{{ option.name }}</label>
                    <div class="product-popup__swatches">
                      {% for value in option.values %}
                        <button type="button" class="product-popup__swatch{% if forloop.first %} is-selected{% endif %}" data-value="{{ value | escape }}">{{ value }}</button>
                      {% endfor %}
                    </div>
                  </div>
                {% else %}
                  <div class="product-popup__option product-popup__option--dropdown" data-option-index="{{ forloop.index }}" data-option-name="{{ option.name | escape }}">
                    <label class="product-popup__option-label">{{ option.name }}</label>
                    <select class="product-popup__size-select">
                      <option value="" selected disabled>Choose your {{ option.name | downcase }}</option>
                      {% for value in option.values %}
                        <option value="{{ value | escape }}">{{ value }}</option>
                      {% endfor %}
                    </select>
                  </div>
                {% endif %}
              {% endfor %}

              <button type="button" class="product-popup__add-to-cart">
                <span class="product-popup__add-to-cart-text">ADD TO CART</span>
                <span class="arrow" aria-hidden="true">&rarr;</span>
              </button>
              <p class="product-popup__message" aria-live="polite"></p>
            </div>

            <script type="application/json" class="product-popup__variants-json">
              [
                {% for variant in product.variants %}
                {
                  "id": {{ variant.id | json }},
                  "price": {{ variant.price | json }},
                  "available": {{ variant.available | json }},
                  {% capture variant_image_json %}{% if variant.featured_image %}{{ variant.featured_image | image_url: width: 400 | json }}{% endif %}{% endcapture %}
                  "image": {% if variant_image_json contains 'Liquid error' or variant_image_json == blank %}null{% else %}{{ variant_image_json }}{% endif %},
                  "option1": {{ variant.option1 | json }},
                  "option2": {{ variant.option2 | json }},
                  "option3": {{ variant.option3 | json }}
                }{% unless forloop.last %},{% endunless %}
                {% endfor %}
              ]
            </script>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  <div class="product-popup-backdrop" id="product-popup-backdrop-{{ section.id }}" hidden></div>

  {% comment %} Data describing the product that must be auto-added when the trigger combo is selected {% endcomment %}
  {% assign auto_add_product = section.settings.auto_add_product %}
  <script type="application/json" id="auto-add-json-{{ section.id }}">
    {
      "id": {{ auto_add_product.id | json }},
      "title": {{ auto_add_product.title | json }},
      "variantId": {{ auto_add_product.selected_or_first_available_variant.id | json }},
      "triggerColor": {{ section.settings.trigger_color | json }},
      "triggerSize": {{ section.settings.trigger_size | json }}
    }
  </script>
</section>

<script>
  (function () {
    var sectionId = {{ section.id | json }};
    var shopCurrency = {{ shop.currency | json }};

    function formatMoney(cents) {
      if (typeof cents !== 'number') return '';
      try {
        return new Intl.NumberFormat(undefined, { style: 'currency', currency: shopCurrency }).format(cents / 100);
      } catch (e) {
        return (cents / 100).toFixed(2) + ' ' + shopCurrency;
      }
    }

    function addToCart(items) {
      return fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ items: items })
      }).then(function (res) {
        if (!res.ok) return res.json().then(function (err) { throw err; });
        return res.json();
      });
    }

    function init() {
      var root = document.getElementById('shoppable-grid-' + sectionId);
      if (!root || root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';

      var backdrop = document.getElementById('product-popup-backdrop-' + sectionId);
      var openPopupEl = null;

      var autoAddData = null;
      try {
        var autoAddDataEl = document.getElementById('auto-add-json-' + sectionId);
        if (autoAddDataEl) autoAddData = JSON.parse(autoAddDataEl.textContent);
      } catch (err) {
        console.error('Shoppable grid: could not parse auto-add product data.', err);
      }

      function closeAllPopups() {
        root.querySelectorAll('.product-popup').forEach(function (p) {
          p.hidden = true;
        });
        root.querySelectorAll('.shoppable-grid__hotspot').forEach(function (b) {
          b.setAttribute('aria-expanded', 'false');
        });
        if (backdrop) backdrop.hidden = true;
        document.body.style.overflow = '';
        openPopupEl = null;
      }

      function bindPopup(popupEl) {
        if (popupEl.dataset.bound === 'true') return;
        popupEl.dataset.bound = 'true';

        var variantsJsonEl = popupEl.querySelector('.product-popup__variants-json');
        var variants = [];
        try {
          variants = variantsJsonEl ? JSON.parse(variantsJsonEl.textContent) : [];
        } catch (err) {
          console.error('Shoppable grid: could not parse variant data.', err);
        }

        var priceEl = popupEl.querySelector('.product-popup__price');
        var imageEl = popupEl.querySelector('.product-popup__image');
        var addToCartBtn = popupEl.querySelector('.product-popup__add-to-cart');
        var messageEl = popupEl.querySelector('.product-popup__message');
        var basePrice = parseInt(priceEl ? priceEl.dataset.basePrice : '0', 10);
        var baseImage = imageEl ? imageEl.getAttribute('src') : '';

        var selectedOptions = {};
        var optionDefaults = {};
        var optionMeta = [];

        popupEl.querySelectorAll('.product-popup__option').forEach(function (optEl) {
          var index = parseInt(optEl.dataset.optionIndex, 10);
          var name = optEl.dataset.optionName;
          optionMeta.push({ index: index, name: name });

          if (optEl.classList.contains('product-popup__option--color')) {
            var swatches = optEl.querySelectorAll('.product-popup__swatch');
            if (swatches.length) {
              selectedOptions[name] = swatches[0].dataset.value;
              optionDefaults[name] = swatches[0].dataset.value;
            }
            swatches.forEach(function (swatch) {
              swatch.addEventListener('click', function () {
                selectedOptions[name] = swatch.dataset.value;
                swatches.forEach(function (s) {
                  s.classList.toggle('is-selected', s === swatch);
                });
                update();
              });
            });
          } else {
            var select = optEl.querySelector('select');
            if (select) {
              var firstRealOption = null;
              for (var i = 0; i < select.options.length; i++) {
                if (select.options[i].value !== '') {
                  firstRealOption = select.options[i].value;
                  break;
                }
              }
              optionDefaults[name] = firstRealOption;
              select.addEventListener('change', function () {
                selectedOptions[name] = select.value;
                update();
              });
            }
          }
        });

        function getEffectiveValue(name) {
          var value = selectedOptions[name];
          if (value === undefined || value === '') value = optionDefaults[name];
          return value;
        }

        function findMatchingVariant() {
          return variants.filter(function (variant) {
            return optionMeta.every(function (opt) {
              var key = 'option' + opt.index;
              var value = getEffectiveValue(opt.name);
              return value === undefined || variant[key] === value;
            });
          })[0] || null;
        }

        function update() {
          var variant = findMatchingVariant();
          var price = variant ? variant.price : basePrice;
          if (priceEl) priceEl.textContent = formatMoney(price);
          var img = (variant && variant.image) || baseImage;
          if (img && imageEl) imageEl.src = img;

          if (variant && !variant.available) {
            addToCartBtn.disabled = true;
            messageEl.textContent = 'This combination is currently unavailable.';
          } else {
            addToCartBtn.disabled = false;
            messageEl.textContent = '';
          }
        }

        addToCartBtn.addEventListener('click', function () {
          var variant = findMatchingVariant();
          if (!variant || !variant.available) {
            messageEl.textContent = 'This combination is currently unavailable.';
            return;
          }

          var items = [{ id: variant.id, quantity: 1 }];
          var autoAdded = false;
          if (autoAddData && autoAddData.variantId && autoAddData.variantId !== variant.id) {
            var values = optionMeta.map(function (opt) { return getEffectiveValue(opt.name); });
            if (values.indexOf(autoAddData.triggerColor) !== -1 && values.indexOf(autoAddData.triggerSize) !== -1) {
              items.push({ id: autoAddData.variantId, quantity: 1 });
              autoAdded = true;
            }
          }

          addToCartBtn.disabled = true;
          messageEl.textContent = 'Adding...';

          addToCart(items)
            .then(function () {
              messageEl.textContent = autoAdded
                ? 'Added to cart, plus ' + autoAddData.title + '!'
                : 'Added to cart!';
              document.dispatchEvent(new CustomEvent('cart:updated'));
            })
            .catch(function () {
              messageEl.textContent = 'Could not add this item to your cart.';
            })
            .finally(function () {
              addToCartBtn.disabled = false;
            });
        });

        popupEl.querySelector('.product-popup__close').addEventListener('click', closeAllPopups);

        update();
      }

      root.querySelectorAll('.shoppable-grid__hotspot').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var targetId = btn.dataset.popupTarget;
          var popupEl = document.getElementById(targetId);
          if (!popupEl) return;

          if (openPopupEl && openPopupEl !== popupEl) {
            openPopupEl.hidden = true;
          }

          bindPopup(popupEl);
          popupEl.hidden = false;
          btn.setAttribute('aria-expanded', 'true');
          if (backdrop) backdrop.hidden = false;
          document.body.style.overflow = 'hidden';
          openPopupEl = popupEl;

          var closeBtn = popupEl.querySelector('.product-popup__close');
          if (closeBtn) closeBtn.focus();
        });
      });

      if (backdrop) {
        backdrop.addEventListener('click', closeAllPopups);
      }

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && openPopupEl) closeAllPopups();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail && event.detail.sectionId === sectionId) {
        var root = document.getElementById('shoppable-grid-' + sectionId);
        if (root) root.dataset.initialized = 'false';
        init();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Shoppable image grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    },
    {
      "type": "product",
      "id": "auto_add_product",
      "label": "Auto-add product",
      "info": "This product is added to the cart automatically when a shopper adds a product with the trigger color and size below."
    },
    {
      "type": "text",
      "id": "trigger_color",
      "label": "Trigger color value",
      "default": "Black"
    },
    {
      "type": "text",
      "id": "trigger_size",
      "label": "Trigger size value",
      "default": "Medium"
    }
  ],
  "blocks": [
    {
      "type": "product_1",
      "name": "Product 1",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "custom_image", "label": "Custom image (optional)", "info": "Defaults to the product's featured image if left empty." },
        { "type": "range", "id": "position_x", "label": "Hotspot horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 68 },
        { "type": "range", "id": "position_y", "label": "Hotspot vertical position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 48 }
      ]
    },
    {
      "type": "product_2",
      "name": "Product 2",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "custom_image", "label": "Custom image (optional)", "info": "Defaults to the product's featured image if left empty." },
        { "type": "range", "id": "position_x", "label": "Hotspot horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 78 },
        { "type": "range", "id": "position_y", "label": "Hotspot vertical position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 45 }
      ]
    },
    {
      "type": "product_3",
      "name": "Product 3",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "custom_image", "label": "Custom image (optional)", "info": "Defaults to the product's featured image if left empty." },
        { "type": "range", "id": "position_x", "label": "Hotspot horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 60 },
        { "type": "range", "id": "position_y", "label": "Hotspot vertical position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 18 }
      ]
    },
    {
      "type": "product_4",
      "name": "Product 4",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "custom_image", "label": "Custom image (optional)", "info": "Defaults to the product's featured image if left empty." },
        { "type": "range", "id": "position_x", "label": "Hotspot horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 58 },
        { "type": "range", "id": "position_y", "label": "Hotspot vertical position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 25 }
      ]
    },
    {
      "type": "product_5",
      "name": "Product 5",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "custom_image", "label": "Custom image (optional)", "info": "Defaults to the product's featured image if left empty." },
        { "type": "range", "id": "position_x", "label": "Hotspot horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 40 },
        { "type": "range", "id": "position_y", "label": "Hotspot vertical position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 45 }
      ]
    },
    {
      "type": "product_6",
      "name": "Product 6",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "custom_image", "label": "Custom image (optional)", "info": "Defaults to the product's featured image if left empty." },
        { "type": "range", "id": "position_x", "label": "Hotspot horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 68 },
        { "type": "range", "id": "position_y", "label": "Hotspot vertical position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 28 }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Shoppable image grid",
      "blocks": [
        { "type": "product_1" },
        { "type": "product_2" },
        { "type": "product_3" },
        { "type": "product_4" },
        { "type": "product_5" },
        { "type": "product_6" }
      ]
    }
  ]
}
{% endschema %}
