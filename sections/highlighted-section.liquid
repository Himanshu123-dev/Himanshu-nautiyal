<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700;900&family=Merriweather:wght@400;700&display=swap" rel="stylesheet">

<div
  class="tb-section"
  style="
    background-color: {{ section.settings.bg_color }};
    --tb-icon-width: {{ section.settings.icon_width }}px;
    --tb-gap: {{ section.settings.gap }}px;
    --tb-title-color: {{ section.settings.title_color }};
    --tb-text-color: {{ section.settings.text_color }};
    --tb-divider-color: {{ section.settings.divider_color }};
  "
>
  <div class="tb-container" style=" max-width: calc(100% - 128px); 
    margin:0 auto;">
    <div class="tb-row">
      {% for block in section.blocks %}
        {% if block.type == 'feature' %}
          <div class="tb-item" {{ block.shopify_attributes }}>
            {% if block.settings.icon %}
              <img
                class="tb-icon"
                src="{{ block.settings.icon | image_url: width: 200 }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
                width="{{ section.settings.icon_width }}"
              >
            {% endif %}

            {% if block.settings.title != blank %}
              <div class="tb-title">{{ block.settings.title }}</div>
            {% endif %}

            {% if block.settings.description != blank %}
              <p class="tb-text">{{ block.settings.description }}</p>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>



{% schema %}
{
  "name": "Feature Highlights",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#2D3C4B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description color",
      "default": "#6B7280"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider line color",
      "default": "#E5E5E5"
    },
    {
      "type": "number",
      "id": "icon_width",
      "label": "Icon width (px)",
      "default": 44
    },
    {
      "type": "number",
      "id": "gap",
      "label": "Gap between items (px)",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Ethically Sourced"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Roasted 4 hours after your order is placed"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Feature Highlights",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
