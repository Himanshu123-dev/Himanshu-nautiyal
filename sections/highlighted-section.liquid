

<div
  class="tb-section"
  style="
    background-color: {{ section.settings.bg_color }};
    --tb-icon-width: {{ section.settings.icon_width }}px;
    --tb-gap: {{ section.settings.gap }}px;
    --tb-title-color: {{ section.settings.title_color }};
    --tb-text-color: {{ section.settings.text_color }};
    --tb-divider-color: {{ section.settings.divider_color }};
  "
>
  <div class="tb-container">
    <div class="tb-row">
      {% for block in section.blocks %}
        {% if block.type == 'feature' %}
          <div class="tb-item" {{ block.shopify_attributes }}>
            {% if block.settings.icon %}
              <img
                class="tb-icon"
                src="{{ block.settings.icon | image_url: width: 200 }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
                width="{{ section.settings.icon_width }}"
              >
            {% endif %}

            {% if block.settings.title != blank %}
              <div class="tb-title">{{ block.settings.title }}</div>
            {% endif %}

            {% if block.settings.description != blank %}
              <p class="tb-text">{{ block.settings.description }}</p>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% style %}
  .tb-section {
    padding: 48px 24px;
  }
  .tb-container {
    max-width: 1446px;
    margin: 0 auto;
  }
  .tb-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--tb-gap, 32px);
  }
  .tb-item {
    flex: 1 1 220px;
    padding-left: var(--tb-gap, 32px);
    border-left: 1px solid var(--tb-divider-color, #e5e5e5);
  }
  .tb-item:first-child {
    padding-left: 0;
    border-left: none;
  }
  .tb-icon {
    display: block;
    width: var(--tb-icon-width, 44px);
    height: auto;
    margin-bottom: 20px;
  }
  .tb-title {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--tb-title-color, #2D3C4B);
    padding-bottom: 12px;
    margin-bottom: 12px;
    border-bottom: 1px solid var(--tb-divider-color, #e5e5e5);
  }
  .tb-text {
    font-size: 13px;
    line-height: 1.5;
    color: var(--tb-text-color, #6b7280);
    margin: 0;
  }

  @media (max-width: 749px) {
    .tb-row {
      flex-direction: column;
    }
    .tb-item {
      border-left: none;
      padding-left: 0;
      border-top: 1px solid var(--tb-divider-color, #e5e5e5);
      padding-top: var(--tb-gap, 32px);
    }
    .tb-item:first-child {
      border-top: none;
      padding-top: 0;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Feature Highlights",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#2D3C4B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description color",
      "default": "#6B7280"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider line color",
      "default": "#E5E5E5"
    },
    {
      "type": "number",
      "id": "icon_width",
      "label": "Icon width (px)",
      "default": 44
    },
    {
      "type": "number",
      "id": "gap",
      "label": "Gap between items (px)",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Ethically Sourced"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Roasted 4 hours after your order is placed"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Feature Highlights",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
