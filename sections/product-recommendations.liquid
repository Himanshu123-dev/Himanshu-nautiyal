<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700;900&family=Merriweather:wght@400;700&display=swap" rel="stylesheet">

<section>
<div class="yml-section">
  <div class="yml-container">
    {% if section.settings.heading != blank %}
      <h2 class="yml-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="yml-grid" style="--yml-cols: {{ section.settings.products_per_row }};">
      {% for block in section.blocks %}
        {% if block.type == 'product' and block.settings.product != blank %}
          {% assign product = block.settings.product %}
          {% assign variant = product.selected_or_first_available_variant %}

          <div class="yml-card" {{ block.shopify_attributes }}>
            <a href="{{ product.url }}" class="yml-image-wrap">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 700 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  loading="lazy"
                  class="yml-image"
                  width="{{ section.settings.image_width }}"
                  height="{{ section.settings.image_height }}"
                >
              {% else %}
                <div class="yml-image yml-image--placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
              {% endif %}
            </a>

            <div class="yml-info">
              <h3 class="yml-title">
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h3>

              {% if block.settings.extra_field_1 != blank %}
                <p class="yml-extra-label">{{ block.settings.extra_field_1 }}</p>
              {% endif %}

              {% if block.settings.extra_field_2 != blank %}
                <p class="yml-extra-text">{{ block.settings.extra_field_2 }}</p>
              {% endif %}

              {% form 'product', product, class: 'yml-form' %}
                <input type="hidden" name="id" value="{{ variant.id }}">
                <button
                  type="submit"
                  class="yml-add-btn"
                  {% unless variant.available %}disabled{% endunless %}
                >
                  <span class="yml-add-label">
                    {% if variant.available %}
                      {{ section.settings.add_to_cart_label | default: 'ADD TO CART' }}
                    {% else %}
                      SOLD OUT
                    {% endif %}
                  </span>
                  <span class="yml-add-price">{{ product.price | money_without_trailing_zeros }}</span>
                </button>
              {% endform %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>
</section>
{% style %}

#shopify-section-template--22995164102895__product_recommendations_ByexyL{
  max-width:1440px;
  margin:0 auto;
  /* padding:0 61px; */
}
  .yml-section {
    padding: 56px 0px;
  }
  
  .yml-heading {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 0.06em;
    margin: 0 0 32px;
    font-family: 'Lato';
    color: #2D3C4B;
  }
  .yml-grid {
    display: flex;
    /* flex-wrap: wrap; */
    gap: 31px;
    justify-content: center;
  }
  .yml-card {
    display: flex;
    flex-direction: column;
    width:322px;
    align-items: center
    /* flex: 1 1 calc((100% - (var(--yml-cols) - 1) * 20px) / var(--yml-cols));
    max-width: calc((100% - (var(--yml-cols) - 1) * 20px) / var(--yml-cols)); */
  }
  @media (max-width: 989px) {
    .yml-card {
      flex: 1 1 calc((100% - 20px) / 2);
      max-width: calc((100% - 20px) / 2);
    }
  }
  @media (max-width: 599px) {
    .yml-card {
      flex: 1 1 100%;
      max-width: 100%;
    }
  }

  .yml-image-wrap {
    display: block;
    width: 100%;
    max-width: {{ section.settings.image_width }}px;
    aspect-ratio: {{ section.settings.image_width }} / {{ section.settings.image_height }};
    overflow: hidden;
    background: #ece3da;
    margin-bottom: 16px;
  }
  .yml-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .yml-info {
    max-width: {{ section.settings.image_width }}px;
  }
  .yml-title {
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    margin: 0 0 4px;
    font-family: 'Lato';
    color: #2D3C4B;
  }
  .yml-title a {
    color: inherit;
    text-decoration: none;
  }
  .yml-extra-label {
    font-family: 'Merriweather';
    font-size: 12px;
    font-style: italic;
    color: #2D3C4B;
    margin: 0 0 4px;
  }
  .yml-extra-text {
    font-family: 'Merriweather';
    font-size: 12px;
    color: #2D3C4B;
    font-style: italic;
    line-height: 1.45;
    margin: 0 0 16px;
    min-height: 34px;

  }
  .yml-form {
    margin: 0;
  }
  .yml-add-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 203PX;
    HEIGHT: 40PX;    
    background: #D7D1C9;
    border: none;
    border-radius: 0 14px 0 14px;
    padding: 10px 18px;
    cursor: pointer;
    font-family: 'Lato';
    transition: background-color 0.15s ease;
  }
  .yml-add-btn:hover:not(:disabled) {
    background: #ddd2c4;
  }
  .yml-add-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .yml-add-label {
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.5px;
    color: #2D3C4B;;
  }
  .yml-add-price {
    font-size: 12px;
    font-weight: 700;
    color: #2D3C4B;
  }

  @media (max-width:1200px)
  {
    #shopify-section-template--22995164102895__product_recommendations_ByexyL{
      padding: 0 28px;
    }

    .yml-extra-text {
      min-height:52px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "You May Also Like",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "YOU MAY ALSO LIKE"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FBF6F1"
    },
    {
      "type": "range",
      "id": "products_per_row",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Products per row (desktop)",
      "default": 4
    },
    {
      "type": "number",
      "id": "image_width",
      "label": "Image width (px)",
      "default": 315
    },
    {
      "type": "number",
      "id": "image_height",
      "label": "Image height (px)",
      "default": 352
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to cart button label",
      "default": "ADD TO CART"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Title aur price yahan se automatically aa jaayenge."
        },
        {
          "type": "text",
          "id": "extra_field_1",
          "label": "Extra field 1 (e.g. Roast Level)",
          "default": "Roast Level"
        },
        {
          "type": "textarea",
          "id": "extra_field_2",
          "label": "Extra field 2 (e.g. description / ingredients)"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "You May Also Like",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
