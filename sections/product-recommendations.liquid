{{ 'product-recommendations.css' | asset_url | stylesheet_tag }}

<section class="product-recs" id="product-recs-{{ section.id }}">
  <div class="product-recs__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="product-recs__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <ul class="product-recs__grid" style="--columns-desktop: {{ section.settings.columns_desktop }};">
      {%- for block in section.blocks -%}
        {%- if block.type == 'product' and block.settings.product != blank -%}
          {%- assign product = block.settings.product -%}
          <li class="product-recs__item" {{ block.shopify_attributes }}>
            <a href="{{ product.url }}" class="product-recs__image-link">
              {%- if product.featured_image != blank -%}
                <img
                  class="product-recs__image"
                  srcset="{{ product.featured_image | image_url: width: 400 }} 400w,
                          {{ product.featured_image | image_url: width: 600 }} 600w,
                          {{ product.featured_image | image_url: width: 800 }} 800w"
                  sizes="(min-width: 990px) 25vw, (min-width: 600px) 50vw, 100vw"
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                  loading="lazy"
                >
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'product-recs__placeholder-svg' }}
              {%- endif -%}
            </a>

            <div class="product-recs__info">
              <a href="{{ product.url }}" class="product-recs__title">{{ product.title }}</a>

              {%- if product.metafields.custom.roast_level != blank -%}
                <p class="product-recs__meta">Roast Level<br>{{ product.metafields.custom.roast_level }}</p>
              {%- elsif block.settings.subtitle != blank -%}
                <p class="product-recs__meta">{{ block.settings.subtitle }}</p>
              {%- endif -%}

              <form method="post" action="/cart/add" class="product-recs__form">
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <div class="product-recs__row">
                  <button
                    type="submit"
                    class="product-recs__add"
                    {% unless product.available %}disabled{% endunless %}
                  >
                    {%- if product.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
                  </button>
                  <span class="product-recs__price">{{ product.price | money }}</span>
                </div>
              </form>
            </div>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "You may also like",
  "tag": "section",
  "class": "section-product-recs",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "info": "Used if the product has no roast_level metafield." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "You may also like",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
