{{ 'brew-guide.css' | asset_url | stylesheet_tag }}

<section class="brew-guide" id="brew-guide-{{ section.id }}">
  <div class="brew-guide__inner">
    <div class="brew-guide__content">
      {%- if section.settings.heading != blank -%}
        <h1 class="brew-guide__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}

      <div class="brew-guide__methods">
        {%- for block in section.blocks -%}
          {%- if block.type == 'method' -%}
            <details class="brew-guide__method" name="brew-guide-accordion-{{ section.id }}" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
              <summary class="brew-guide__method-summary">
                <span>{{ block.settings.method_name | default: 'Method name' }}</span>
                <svg class="brew-guide__chevron" width="14" height="9" viewBox="0 0 14 9" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1 1L7 7L13 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </summary>
              <div class="brew-guide__method-body">
                {%- if block.settings.time_value != blank -%}
                  <p class="brew-guide__time"><strong>{{ block.settings.time_label | default: 'Total time:' }}</strong> {{ block.settings.time_value }}</p>
                {%- endif -%}
                {%- if block.settings.method_text != blank -%}
                  <div class="brew-guide__text">{{ block.settings.method_text }}</div>
                {%- endif -%}
                {%- if block.settings.link_text != blank -%}
                  <a href="{{ block.settings.link_url }}" class="brew-guide__link">{{ block.settings.link_text }}</a>
                {%- endif -%}
              </div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_url }}" class="brew-guide__button">
          <span>{{ section.settings.button_label }}</span>
          <svg width="18" height="12" viewBox="0 0 18 12" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 6H17M17 6L12 1M17 6L12 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {%- endif -%}
    </div>

    <div class="brew-guide__media">
      {%- if section.settings.image != blank -%}
        <img
          srcset="{{ section.settings.image | image_url: width: 600 }} 600w,
                  {{ section.settings.image | image_url: width: 900 }} 900w,
                  {{ section.settings.image | image_url: width: 1200 }} 1200w,
                  {{ section.settings.image | image_url: width: 1600 }} 1600w"
          sizes="(min-width: 990px) 55vw, 100vw"
          src="{{ section.settings.image | image_url: width: 1200 }}"
          alt="{{ section.settings.image.alt | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="lazy"
        >
      {%- else -%}
        <div class="brew-guide__media-placeholder">{{ 'image' | placeholder_svg_tag: 'brew-guide__placeholder-svg' }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('brew-guide-{{ section.id }}');
    if (!root) return;
    var details = root.querySelectorAll('.brew-guide__method');

    // Native <details name="..."> already makes these mutually exclusive in
    // modern browsers. This listener is a safe fallback for older browsers
    // that ignore the name attribute.
    details.forEach(function (el) {
      el.addEventListener('toggle', function () {
        if (!el.open) return;
        details.forEach(function (other) {
          if (other !== el) other.open = false;
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Brew guide",
  "tag": "section",
  "class": "section-brew-guide",
  "settings": [
    { "type": "text", "id": "heading", "label": "Section heading", "default": "Brewing methods" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Download our brew guides" },
    { "type": "url", "id": "button_url", "label": "Button URL" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "blocks": [
    {
      "type": "method",
      "name": "Brew method",
      "settings": [
        { "type": "text", "id": "method_name", "label": "Method name", "default": "Method name" },
        { "type": "text", "id": "time_label", "label": "Time prefix", "default": "Total time:" },
        { "type": "text", "id": "time_value", "label": "Time value", "default": "5 min", "info": "Leave blank to hide the time line." },
        { "type": "richtext", "id": "method_text", "label": "Description", "default": "<p>Lorem ipsum dolor sit amet, consectetur erat adipising elit. Donec erat urna, tincidunt neque gravida neque sed, fringilla commodo dui. Cras orci arcu, sodales id neque sit amet.</p>" },
        { "type": "text", "id": "link_text", "label": "Inline link text", "default": "Learn more" },
        { "type": "url", "id": "link_url", "label": "Inline link URL" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Brew guide",
      "blocks": [
        { "type": "method" },
        { "type": "method" },
        { "type": "method" },
        { "type": "method" }
      ]
    }
  ]
}
{% endschema %}
