<section class="brewing-methods brewing-methods-{{ section.id }}">
  <div class="brewing-methods__inner">
    <div class="brewing-methods__row">

      <div class="brewing-methods__content">
        <h2 class="brewing-methods__heading">{{ section.settings.heading }}</h2>

        <div class="brewing-methods__accordion">
          {% for block in section.blocks %}
            {% if block.type == 'method' %}
              <div class="accordion-item{% if forloop.first %} is-open{% endif %}" data-accordion-item {{ block.shopify_attributes }}>
                <button
                  type="button"
                  class="accordion-item__trigger"
                  aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
                  aria-controls="bm-panel-{{ section.id }}-{{ forloop.index }}"
                  id="bm-trigger-{{ section.id }}-{{ forloop.index }}"
                >
                  <span class="accordion-item__title">{{ block.settings.title }}</span>
                  <span class="accordion-item__icon" aria-hidden="true">
                    <svg viewBox="0 0 14 8" width="14" height="8" fill="none">
                      <path d="M1 1L7 7L13 1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </button>

                <div
                  class="accordion-item__panel"
                  id="bm-panel-{{ section.id }}-{{ forloop.index }}"
                  role="region"
                  aria-labelledby="bm-trigger-{{ section.id }}-{{ forloop.index }}"
                >
                  <div class="accordion-item__panel-inner">
                    {% if block.settings.total_time != blank %}
                      <p class="accordion-item__time"><strong>Total time:</strong> {{ block.settings.total_time }}</p>
                    {% endif %}

                    <div class="accordion-item__description">{{ block.settings.description }}</div>

                    {% if block.settings.link_url != blank %}
                      <a href="{{ block.settings.link_url }}" class="accordion-item__link">{{ block.settings.link_text }}</a>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link | default: '#' }}" class="brewing-methods__button">
            <span>{{ section.settings.button_label }}</span>
            <svg viewBox="0 0 16 12" width="16" height="12" fill="none" aria-hidden="true">
              <path d="M9.5 1L15 6L9.5 11M15 6H1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {% endif %}
      </div>

      <div class="brewing-methods__media">
        {% if section.settings.image %}
          <img
            class="brewing-methods__image"
            src="{{ section.settings.image | image_url: width: 1200 }}"
            srcset="
              {{ section.settings.image | image_url: width: 600 }} 600w,
              {{ section.settings.image | image_url: width: 900 }} 900w,
              {{ section.settings.image | image_url: width: 1200 }} 1200w,
              {{ section.settings.image | image_url: width: 1600 }} 1600w
            "
            sizes="(max-width: 749px) 100vw, {{ section.settings.image_width }}px"
            alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
            width="{{ section.settings.image_width }}"
            height="{{ section.settings.image_height }}"
            loading="lazy"
          >
        {% else %}
          <div class="brewing-methods__image brewing-methods__image--placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

    </div>
  </div>
</section>

<script>
  (function () {
    function initBrewingAccordion(sectionId) {
      var root = document.getElementById('shopify-section-' + sectionId);
      if (!root) return;

      var items = root.querySelectorAll('[data-accordion-item]');

      items.forEach(function (item) {
        var trigger = item.querySelector('.accordion-item__trigger');
        if (!trigger) return;

        trigger.addEventListener('click', function () {
          var wasOpen = item.classList.contains('is-open');

          items.forEach(function (other) {
            other.classList.remove('is-open');
            var otherTrigger = other.querySelector('.accordion-item__trigger');
            if (otherTrigger) otherTrigger.setAttribute('aria-expanded', 'false');
          });

          if (!wasOpen) {
            item.classList.add('is-open');
            trigger.setAttribute('aria-expanded', 'true');
          }
        });
      });
    }

    document.addEventListener('DOMContentLoaded', function () {
      initBrewingAccordion('{{ section.id }}');
    });

    document.addEventListener('shopify:section:load', function (event) {
      initBrewingAccordion(event.detail.sectionId);
    });
  })();
</script>

{% schema %}
{
  "name": "Brewing methods",
  "tag": "section",
  "class": "section-brewing-methods",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Brewing Methods"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image width (px)",
      "min": 700,
      "max": 800,
      "step": 2,
      "default": 762
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Image height (px)",
      "min": 300,
      "max": 500,
      "step": 2,
      "default": 460
    },
    {
      "type": "range",
      "id": "top_gap",
      "label": "Space between top border and image",
      "min": 155,
      "max": 250,
      "step": 1,
      "default": 243
    },
    {
      "type": "range",
      "id": "content_top_gap",
      "label": "Space between top border and text content",
      "min": 100,
      "max": 200,
      "step": 1,
      "default": 156
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Download our brew guides"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FAF9F6"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Divider / border colour",
      "default": "#D8D5CE"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading & title colour",
      "default": "#1F2430"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text colour",
      "default": "#3A3F4B"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#2B2F3A"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text colour",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "method",
      "name": "Method",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Method name",
          "default": "Method Name"
        },
        {
          "type": "text",
          "id": "total_time",
          "label": "Total time",
          "default": "5 min"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link text",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brewing methods",
      "blocks": [
        { "type": "method" },
        { "type": "method" },
        { "type": "method" },
        { "type": "method" }
      ]
    }
  ]
}
{% endschema %}
