            "custom_liquid": "{%- liquid\n  assign roast_text = product.metafields.custom.roast_level.value\n  assign roast_key  = roast_text | strip | downcase\n  assign roast_count = 0\n\n  case roast_key\n    when 'medium light roast'\n      assign roast_count = 1\n    when 'medium roast'\n      assign roast_count = 2\n    when 'medium dark roast'\n      assign roast_count = 3\n    when 'dark roast'\n      assign roast_count = 4\n  endcase\n\n  # ---- FALLBACK: metafield khali ho to tags / title se detect karo ----\n  if roast_count == 0\n    assign p_title = product.title | downcase\n\n    if product.tags contains 'Medium Light Roast' or p_title contains 'medium light roast'\n      assign roast_count = 1\n      assign roast_text = 'Medium Light Roast'\n    elsif product.tags contains 'Medium Dark Roast' or p_title contains 'medium dark roast'\n      assign roast_count = 3\n      assign roast_text = 'Medium Dark Roast'\n    elsif product.tags contains 'Medium Roast' or p_title contains 'medium roast'\n      assign roast_count = 2\n      assign roast_text = 'Medium Roast'\n    elsif product.tags contains 'Dark Roast' or p_title contains 'dark roast'\n      assign roast_count = 4\n      assign roast_text = 'Dark Roast'\n    endif\n  endif\n-%}\n\n{%- if roast_count > 0 -%}\n<div class=\"roast-level-widget\">\n  <div class=\"roast-circles\" aria-label=\"{{ roast_text }} - {{ roast_count }} out of 4\">\n    {%- for i in (1..4) -%}\n      <span class=\"roast-dot{% if i <= roast_count %} is-filled{% endif %}\"></span>\n    {%- endfor -%}\n  </div>\n  <div class=\"roast-copy\">\n    <span class=\"roast-name\">{{ roast_text | upcase }}</span>\n    <span class=\"roast-sep\">|</span>\n    <span class=\"roast-arabica\">100% ARABICA COFFEE</span>\n  </div>\n</div>\n\n<style>\n  .roast-level-widget{\n    align-items:center;\n  }\n  .roast-circles{ \n   display:flex; \n    gap:3px; \n}\n  .roast-dot{\n    width:14px;\n    height:14px;\n    border-radius:50%;\n    border:1px solid #883434;\n    display:inline-block;\n    background:transparent;\n  }\n  .roast-dot.is-filled{                  background:#883434;\n }\n  .roast-copy{\n    font-size:12px;\n    font-weight:700;\n    letter-spacing:4%;\n    color:#883434;\n    font-family:'Lato';\n    height: 34px;\n    display: flex;\n    align-items: center;\n\n  }\n  .roast-sep{ \nmargin:0 8px; opacity:.5;\n }\n</style>\n{%- endif -%}"
